<?xml version="1.0" encoding="UTF-8"?>
<!-- Upload this file to Administration | Root project | Maven Settings.
     TeamCity uses it to resolve Kotlin DSL dependencies from .teamcity/pom.xml. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <!-- Overrides Maven's (3.8.1+) built-in HTTP blocker so the TeamCity
         server's DSL repository can be reached over plain HTTP. -->
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>external:dummy:*</mirrorOf>
      <name>Disable HTTP blocker</name>
      <url>http://0.0.0.0/</url>
      <blocked>false</blocked>
    </mirror>
  </mirrors>
</settings>
